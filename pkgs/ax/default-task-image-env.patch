+// DefaultImage returns the task image used when a Task sets no spec.image:
+// $AX_DEFAULT_TASK_IMAGE if set, otherwise v1alpha1.DefaultTaskImage.
+func DefaultImage() string {
+	if image := os.Getenv("AX_DEFAULT_TASK_IMAGE"); image != "" {
+		return image
+	}
+	return v1alpha1.DefaultTaskImage
